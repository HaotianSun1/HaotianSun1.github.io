---
const {
  title = "Haotian Sun",
  description = "Haotian Sun — astronomy master's student working on radio transients and time-domain astrophysics.",
} = Astro.props;

const path = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/notes", label: "Notes" },
  { href: "/interests", label: "Interests" },
];

const origin = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, origin);
const socialImage = new URL("/og.png", origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15243d" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <title>{title}</title>
  </head>
  <body>
    <aside class="sidebar">
      <div class="sidebar-inner">
        <a class="identity" href="/" aria-label="Haotian Sun, home">
          <span class="avatar" aria-hidden="true">HS</span>
          <span class="identity-copy">
            <span class="name">Haotian Sun</span>
            <span class="role">Astronomy master's student</span>
          </span>
        </a>

        <nav aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={{ active: item.href === "/" ? path === "/" : path.startsWith(item.href) }}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="sidebar-footer">
          <span>Amsterdam, NL</span>
          <span>© {new Date().getFullYear()} Haotian Sun</span>
        </div>
      </div>
    </aside>

    <main id="main-content">
      <div class="content-shell">
        <slot />
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --sidebar: #15243d;
    --sidebar-deep: #0d1728;
    --paper: #ffffff;
    --text: #747b82;
    --text-strong: #303941;
    --text-soft: #9aa0a5;
    --accent: #46aa8b;
    --accent-dark: #27876b;
    --border: #e7e9e9;
    --soft: #f5f8f7;
    --sidebar-width: clamp(300px, 30vw, 430px);
  }

  * { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--text);
    font-family: "Source Sans 3", "Helvetica Neue", Arial, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.75;
    text-rendering: optimizeLegibility;
  }

  ::selection { background: rgba(70, 170, 139, 0.22); color: var(--text-strong); }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-width);
    color: rgba(255, 255, 255, 0.72);
    background:
      radial-gradient(circle at 24% 14%, rgba(139, 174, 198, 0.22), transparent 21rem),
      radial-gradient(circle at 70% 75%, rgba(70, 170, 139, 0.15), transparent 19rem),
      linear-gradient(150deg, rgba(21, 36, 61, 0.92), rgba(10, 18, 32, 0.98)),
      var(--sidebar);
    overflow: hidden;
  }

  .sidebar::before,
  .sidebar::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
  }

  .sidebar::before {
    width: 2px;
    height: 2px;
    top: 11%;
    left: 20%;
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 92px 64px rgba(255, 255, 255, 0.35), 210px 14px rgba(255, 255, 255, 0.28), 54px 280px rgba(255, 255, 255, 0.24), 236px 360px rgba(255, 255, 255, 0.18);
  }

  .sidebar::after {
    width: 34rem;
    height: 11rem;
    left: -9rem;
    bottom: -6rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 0 3.5rem rgba(255, 255, 255, 0.018), 0 0 0 7rem rgba(255, 255, 255, 0.012);
    transform: rotate(-8deg);
  }

  .sidebar-inner {
    position: relative;
    z-index: 1;
    min-height: 100%;
    padding: clamp(48px, 8vh, 96px) clamp(36px, 5vw, 72px) 38px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    color: inherit;
    text-decoration: none;
  }

  .avatar {
    width: 96px;
    height: 96px;
    display: grid;
    place-items: center;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    box-shadow: 0 14px 42px rgba(0, 0, 0, 0.24);
  }

  .identity-copy {
    display: block;
    max-width: 280px;
    font-size: 1.28rem;
    line-height: 1.35;
  }

  .name { color: #fff; font-family: "Space Grotesk", sans-serif; font-weight: 600; }
  .role { color: rgba(255, 255, 255, 0.53); }

  .sidebar nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-top: 40px;
  }

  .sidebar nav a {
    position: relative;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1.08rem;
    line-height: 1.9;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .sidebar nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.28em;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 180ms ease;
  }

  .sidebar nav a:hover,
  .sidebar nav a.active { color: #fff; transform: translateX(-4px); }
  .sidebar nav a.active::after,
  .sidebar nav a:hover::after { width: 100%; }

  .sidebar-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  main { min-height: 100vh; margin-left: var(--sidebar-width); }

  .content-shell {
    width: min(100%, 980px);
    padding: clamp(68px, 9vw, 120px) clamp(32px, 7vw, 96px) 90px;
  }

  h1, h2, h3 {
    color: var(--text-strong);
    font-family: "Space Grotesk", "Source Sans 3", sans-serif;
    font-weight: 600;
    line-height: 1.25;
  }

  h1 { margin: 0 0 18px; font-size: clamp(2.45rem, 5vw, 4.65rem); letter-spacing: -0.045em; }
  h2 { margin: 64px 0 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border); font-size: clamp(1.55rem, 2.4vw, 2rem); letter-spacing: -0.02em; }
  h3 { margin: 34px 0 10px; font-size: 1.2rem; }
  p { margin: 0 0 1.45rem; }
  strong { color: var(--text-strong); font-weight: 600; }

  a {
    color: var(--accent-dark);
    text-decoration-color: rgba(39, 135, 107, 0.35);
    text-underline-offset: 0.2em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  a:hover { color: #17644f; text-decoration-color: currentColor; }
  ul, ol { padding-left: 1.25rem; }
  li { margin: 0.45rem 0; padding-left: 0.25rem; }

  .eyebrow {
    margin-bottom: 18px;
    color: var(--accent-dark);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lead { max-width: 760px; color: var(--text-strong); font-size: clamp(1.3rem, 2.5vw, 1.72rem); line-height: 1.55; }
  .subtitle { margin: -8px 0 34px; color: var(--accent-dark); font-size: 1.08rem; }

  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 9px 18px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--paper);
    color: var(--text-strong);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .button.primary { border-color: var(--accent-dark); background: var(--accent-dark); color: #fff; }
  .button:hover { border-color: var(--accent); color: var(--accent-dark); text-decoration: none; }
  .button.primary:hover { background: #17644f; color: #fff; }

  @media (max-width: 860px) {
    :root { --sidebar-width: 100%; }
    .sidebar { position: relative; width: 100%; min-height: auto; }
    .sidebar-inner { min-height: auto; padding: 30px 24px 26px; align-items: flex-start; text-align: left; }
    .identity { flex-direction: row; align-items: center; gap: 18px; }
    .avatar { width: 58px; height: 58px; margin: 0; font-size: 0.9rem; }
    .identity-copy { font-size: 1.05rem; }
    .identity-copy span { display: block; }
    .sidebar nav { width: 100%; flex-direction: row; align-items: center; gap: 21px; margin-top: 24px; overflow-x: auto; padding-bottom: 2px; }
    .sidebar nav a { flex: 0 0 auto; font-size: 0.92rem; }
    .sidebar nav a:hover, .sidebar nav a.active { transform: none; }
    .sidebar-footer { display: none; }
    main { margin-left: 0; }
    .content-shell { padding: 56px 24px 72px; }
  }

  @media (max-width: 520px) {
    body { font-size: 17px; }
    .role { font-size: 0.92rem; }
    .sidebar nav { gap: 17px; }
    h2 { margin-top: 50px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: 0.01ms !important; }
  }
</style>
